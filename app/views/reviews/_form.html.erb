<div class="card">
  <% if @review.errors.any? %>
    <div class="error-box">
      <ul>
        <% @review.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: [@book, @review] do |f| %>
    <p>
      <%= f.label :content %><br>
      <%= f.text_area :content %>
    </p>

    <p>
      <%= f.label :rating %><br>
      <%= f.number_field :rating %>
    </p>

    <p>
      <%= f.submit "Submit", class: "btn" %>
    </p>
  <% end %>
</div>